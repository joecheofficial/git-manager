{
  "repositoryRoot": "{{REPOSITORY_ROOT}}",
  "branchCleanup": {
    "baseRef": "refs/heads/main",
    "minAgeDays": 30,
    "protectedBranches": [
      "main",
      "master",
      "develop",
      "release/*",
      "recovery/*",
      "*preserve*"
    ],
    "activeBranches": [],
    "backupRoot": "/absolute/path/to/backups"
  }
}
