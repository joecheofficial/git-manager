  ],
  "actions": ["safety-check"],
  "safety": {
    "writes": false,
    "destructive": false,
    "approvalRequired": false,
    "dryRunDefault": false,
    "rule": "Performs combined pre-commit safety check, validating both secret credentials and large file thresholds."
