{
  "id": "agent/git-manager/scan-secrets",
  "layer": "agent",
  "owner": "git-manager",
  "title": "Scan staged files for secret API keys and credentials",
  "tags": ["git", "security", "secrets", "scanner", "read-only"],
  "phrases": [
    "scan for secrets",
    "check for api keys",
    "am i committing secrets",
    "scan staged changes for credentials",
    "git manager scan secrets"
  ],
  "actions": ["scan-secrets"],
  "safety": {
    "writes": false,
    "destructive": false,
    "approvalRequired": false,
    "dryRunDefault": false,
    "rule": "Scans staged git changes for live API keys, tokens, and private keys. Uses gitleaks if installed or falls back to built-in regex scanner."
  },
  "inputMode": "structured",
  "requiredContext": [],
  "outputMode": "text",
  "fallbackPolicy": "deterministic_first",
  "handler": "./scan-secrets.js"
}
